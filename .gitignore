# Public root entries. Local notes, exports and ad-hoc tools stay untracked by default.
/*
*.md
*.txt
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.webm
!/.gitignore
!/.gitattributes
!/.githooks/
!/.npmrc
!/CONTRIBUTING.md
!/LICENSE
!/PRIVACY.md
!/README.md
!/README.zh-CN.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/vitest.config.mts
!/android-app/
!/apps/
!/docs/
!/native/
!/QFastTransmission/
!/qft-web/
!/scripts/
!/shared/
!/src-tauri/
!/tests/
!/shared/assets/favicon.png
!/shared/assets/logo.png
!/shared/assets/logo-ui.png
!/src-tauri/icons/icon.png
!/src-tauri/icons/installer.png
!/android-app/app/src/main/res/drawable-nodpi/ic_launcher.png
!/android-app/app/src/main/assets/THIRD_PARTY_LICENSES-ANDROID.txt

/.githooks/*
!/.githooks/pre-commit
/native/*
!/native/VerificationHost.cs

# Vendored QFastTransmission library.
/QFastTransmission/*
!/QFastTransmission/.gitattributes
!/QFastTransmission/Cargo.toml
!/QFastTransmission/Cargo.lock
!/QFastTransmission/LICENSE
